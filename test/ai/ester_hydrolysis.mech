mechanism "Acid-catalysed hydrolysis of ethyl acetate"

# 1. protonation of the carbonyl oxygen by hydronium
C[C:2](=[O:1])[O:3][CH2:4]C + [H:5][OH2+:6] + [H:8][OH:7]
  lp 1 -> 5
  bond 5-6 -> 6
<=> "H3O+"
# 2. water attacks the activated carbonyl carbon
C[C:2](=[O+:1][H:5])[O:3][CH2:4]C + [OH2:6] + [H:8][OH:7]
  lp 7 -> 2
  bond 1-2 -> 1
<=>
# 3. deprotonation of the added water (oxonium) by water
C[C:2]([O:1][H:5])([OH+:7][H:8])[O:3][CH2:4]C + [OH2:6]
  lp 6 -> 8
  bond 7-8 -> 7
<=>
# 4. protonation of the ethoxy oxygen
C[C:2]([O:1][H:5])([OH:7])[O:3][CH2:4]C + [H:8][OH2+:6]
  lp 3 -> 8
  bond 6-8 -> 6
<=>
# 5. reform C=O, ethanol leaves
C[C:2]([O:1][H:5])([OH:7])[O+:3]([H:8])[CH2:4]C + [OH2:6]
  lp 1 -> 1-2
  bond 2-3 -> 3
<=>
# 6. deprotonation regenerates the acid catalyst
C[C:2](=[O+:1][H:5])[OH:7] + [H:8][O:3][CH2:4]C + [OH2:6]
  lp 6 -> 5
  bond 1-5 -> 1
<=>
C[C:2](=[O:1])[OH:7] + [H:8][O:3][CH2:4]C + [H:5][OH2+:6]
